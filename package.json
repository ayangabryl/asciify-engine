{
  "name": "asciify-engine",
  "version": "4.33.0",
  "description": "ASCII components, backgrounds and media for the web: loaders, toasts, transitions, animated hero backgrounds, and image, video and GIF to ASCII. GPU-rendered, themeable, framework-agnostic, with an agent skill.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./hover": {
      "import": {
        "types": "./dist/hover.d.ts",
        "default": "./dist/hover.js"
      },
      "require": {
        "types": "./dist/hover.d.cts",
        "default": "./dist/hover.cjs"
      }
    },
    "./studio": {
      "import": {
        "types": "./dist/studio.d.ts",
        "default": "./dist/studio.js"
      },
      "require": {
        "types": "./dist/studio.d.cts",
        "default": "./dist/studio.cjs"
      }
    },
    "./field": {
      "import": {
        "types": "./dist/field.d.ts",
        "default": "./dist/field.js"
      },
      "require": {
        "types": "./dist/field.d.cts",
        "default": "./dist/field.cjs"
      }
    },
    "./kit": {
      "import": {
        "types": "./dist/kit.d.ts",
        "default": "./dist/kit.js"
      },
      "require": {
        "types": "./dist/kit.d.cts",
        "default": "./dist/kit.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills/asciify-engine",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples/media-background.ts",
    "examples/studio-composition.ts",
    "examples/layered-composition.ts",
    "examples/print-composition.ts",
    "THIRD_PARTY.md",
    "licenses",
    "examples/living-image.ts",
    "examples/glyph-field.ts",
    "examples/three-live.ts",
    "STABILITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:push": "git push origin main --follow-tags",
    "prepublishOnly": "npm run build",
    "test:browser": "node tests/serve-browser.mjs",
    "test:hover": "node tests/hover-browser.mjs",
    "test:finish": "node tests/hero-finish-browser.mjs",
    "test:studio": "node tests/studio-browser.mjs",
    "test:parity": "node tests/studio-parity-browser.mjs",
    "bench:looks": "node tests/hover-cost-browser.mjs",
    "bench:dither": "node scripts/benchmark-dither.mjs",
    "bench:hover": "node scripts/benchmark-hover-fields.mjs",
    "test:visual": "node tests/visual-browser.mjs",
    "test:effects": "node tests/field-effects-browser.mjs",
    "test:headless": "node tests/headless-node.mjs",
    "build:glyphs": "node scripts/build-glyph-table.mjs",
    "test:element": "node tests/element-source-browser.mjs"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "ascii-background",
    "ascii-animation",
    "ascii-components",
    "ascii-ui",
    "animated-background",
    "hero-background",
    "image-to-ascii",
    "video-to-ascii",
    "gif-to-ascii",
    "ascii-text",
    "character-art",
    "canvas",
    "webgl",
    "generative-art",
    "react",
    "vue",
    "svelte",
    "agent-skill"
  ],
  "author": "ayangabryl",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://asciify.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayangabryl/asciify-engine.git"
  },
  "dependencies": {
    "figlet": "^1.11.0",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "mediabunny": "^1.56.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "terser": "^5.46.0",
    "tsup": "^8.4.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  }
}
